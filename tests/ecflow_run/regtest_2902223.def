suite regtest_2902223
    edit ECF_HOME '/scratch4/NCEPDEV/nems/Denise.Worthen/ufs_dw/tests/ecflow_run'
    edit ECF_INCLUDE '/scratch4/NCEPDEV/nems/Denise.Worthen/ufs_dw/tests/ecflow_run'
    edit ECF_KILL_CMD kill -15 %ECF_RID% > %ECF_JOB%.kill 2>&1
    edit ECF_TRIES 2
    label src_dir '/scratch4/NCEPDEV/nems/Denise.Worthen/ufs_dw'
    label run_dir '/scratch4/NCEPDEV/stmp/Denise.Worthen/RT_RUNDIRS/Denise.Worthen/FV3_RT/rt_2902223'
    limit max_builds 10
    limit max_jobs 30
  task compile_s2swa_32bit_intel
      label build_options '-DAPP=S2SWA -D32BIT=ON -DCCPP_SUITES=FV3_GFS_v17_coupled_p8,FV3_GFS_v17_coupled_p8_ugwpv1'
      inlimit max_builds
    task cpld_control_p8_mixedmode_intel
      inlimit max_jobs
      trigger compile_s2swa_32bit_intel == complete
    task cpld_control_gefs_intel
      inlimit max_jobs
      trigger compile_s2swa_32bit_intel == complete
    task cpld_restart_gefs_intel
      inlimit max_jobs
      trigger compile_s2swa_32bit_intel == complete and cpld_control_gefs_intel == complete
    task cpld_dcp_gefs_intel
      inlimit max_jobs
      trigger compile_s2swa_32bit_intel == complete
  task compile_s2swa_32bit_pdlib_intel
      label build_options '-DAPP=S2SWA -D32BIT=ON -DCCPP_SUITES=FV3_GFS_v17_coupled_p8_ugwpv1 -DPDLIB=ON'
      inlimit max_builds
    task cpld_control_gfsv17_intel
      inlimit max_jobs
      trigger compile_s2swa_32bit_pdlib_intel == complete
    task cpld_control_gfsv17_iau_intel
      inlimit max_jobs
      trigger compile_s2swa_32bit_pdlib_intel == complete and cpld_control_gfsv17_intel == complete
    task cpld_restart_gfsv17_intel
      inlimit max_jobs
      trigger compile_s2swa_32bit_pdlib_intel == complete and cpld_control_gfsv17_intel == complete
    task cpld_restart_gfsv17_iau_intel
      inlimit max_jobs
      trigger compile_s2swa_32bit_pdlib_intel == complete and cpld_control_gfsv17_iau_intel == complete
    task cpld_mpi_gfsv17_intel
      inlimit max_jobs
      trigger compile_s2swa_32bit_pdlib_intel == complete
  task compile_s2s_32bit_sfs_intel
      label build_options '-DAPP=S2S -D32BIT=ON -DHYDRO=ON -DCCPP_SUITES=FV3_GFS_v17_coupled_p8_ugwpv1'
      inlimit max_builds
    task cpld_control_sfs_intel
      inlimit max_jobs
      trigger compile_s2s_32bit_sfs_intel == complete
    task cpld_restart_sfs_intel
      inlimit max_jobs
      trigger compile_s2s_32bit_sfs_intel == complete and cpld_control_sfs_intel == complete
  task compile_s2s_32bit_sfs_debug_intel
      label build_options '-DAPP=S2S -D32BIT=ON -DHYDRO=ON -DCCPP_SUITES=FV3_GFS_v17_coupled_p8_ugwpv1 -DDEBUG=ON'
      inlimit max_builds
