plot/nolab/vlim=50:100 pdat[d=1],pdat[d=2],pdat[d=3],pdat[d=4],pdat[d=5],pdat[d=6],pdat[d=7],pdat[d=8],pdat[d=9],pdat[d=10],pdat[d=11],pdat[d=12],pdat[d=13],pdat[d=14],pdat[d=15],pdat[d=16],pdat[d=17],pdat[d=18]
